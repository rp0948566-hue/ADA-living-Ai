#!/usr/bin/env python3
"""macOS mdfind for Linux: mdfind [-onlyin DIR] [-name WORDS] WORDS. Names via `find`, content via grep -ril."""
import os, subprocess, sys
a, root, name = sys.argv[1:], os.path.expanduser('~'), False
words, i = [], 0
while i < len(a):
    if a[i] == '-onlyin': root = os.path.expanduser(a[i + 1]); i += 1
    elif a[i] == '-name': name = True
    else: words.append(a[i])
    i += 1
q = ' '.join(words).strip()
if not q: sys.exit(0)
skip = ['-not', '-path', '*/.*', '-not', '-path', '*/node_modules/*']
out = subprocess.run(['find', root, '-maxdepth', '8', *skip, '-iname', '*' + q.replace(' ', '*') + '*'], capture_output=True, text=True).stdout
if not name:
    out += subprocess.run(['grep', '-rIil', '--exclude-dir=.*', '--exclude-dir=node_modules', '-m1', q, root], capture_output=True, text=True, timeout=20).stdout
print('\n'.join(dict.fromkeys(out.splitlines())))
